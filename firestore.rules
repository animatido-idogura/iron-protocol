rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Shared helper: is the request from the app creator?
    function isCreator() {
      return request.auth != null
             && request.auth.token.email == 'animatido@gmail.com';
    }

    match /tracks/{trackId} {

      // Anyone signed in can read tracks.
      allow read: if request.auth != null;

      // Only the creator can add or delete tracks, or edit their content.
      allow create, delete: if isCreator();

      // The creator can edit anything; any signed-in listener may update
      // ONLY the counter fields (likes / plays / comments) so that liking,
      // play counts, and comment counts keep working for everyone.
      allow update: if isCreator() || (request.auth != null && onlyCounters());

      function onlyCounters() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasOnly(['likes', 'plays', 'comments']);
      }

      // Comments: anyone signed in can read and create;
      // a comment can only be deleted by its own author.
      match /comments/{commentId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth != null
                      && request.auth.uid == resource.data.userId;
      }
    }

    // Users: each user reads/writes their own document (personal likes &
    // favorites). The creator may also READ every user doc to see the
    // email list in the admin panel.
    match /users/{userId} {
      allow read:  if request.auth != null
                   && (request.auth.uid == userId || isCreator());
      allow write: if request.auth != null
                   && request.auth.uid == userId;
    }

    // Presence: anyone signed in can read; each user writes only their own.
    match /presence/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId;
    }

    // Messages: listeners send messages to the creator (subject + body).
    match /messages/{messageId} {
      // A signed-in user can send a message as themselves.
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      // The sender or the creator can read a message.
      allow read: if request.auth != null
                  && (resource.data.userId == request.auth.uid || isCreator());

      // The creator can reply (any field). The sender may only flip the
      // readByUser flag (to clear their notification dot).
      allow update: if isCreator()
                    || (request.auth != null
                        && resource.data.userId == request.auth.uid
                        && request.resource.data.diff(resource.data)
                             .affectedKeys().hasOnly(['readByUser']));

      // Only the creator can delete messages.
      allow delete: if isCreator();
    }

  }
}
