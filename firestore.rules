rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /tracks/{trackId} {

      // Anyone signed in can read tracks.
      allow read: if request.auth != null;

      // Only the creator can add or delete tracks, or edit their content.
      allow create, delete: if isCreator();

      // The creator can edit anything; any signed-in listener may update
      // ONLY the counter fields (likes / plays / comments) so that liking,
      // play counts, and comment counts keep working for everyone.
      allow update: if isCreator() || (request.auth != null && onlyCounters());

      function isCreator() {
        return request.auth != null
               && request.auth.token.email == 'animatido@gmail.com';
      }
      function onlyCounters() {
        return request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasOnly(['likes', 'plays', 'comments']);
      }

      // Comments: anyone signed in can read and create;
      // a comment can only be deleted by its own author.
      match /comments/{commentId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth != null
                      && request.auth.uid == resource.data.userId;
      }
    }

    // Users: each user reads/writes their own document (personal likes &
    // favorites). The creator may also READ every user doc to see the
    // email list in the admin panel.
    match /users/{userId} {
      allow read:  if request.auth != null
                   && (request.auth.uid == userId
                       || request.auth.token.email == 'animatido@gmail.com');
      allow write: if request.auth != null
                   && request.auth.uid == userId;
    }

    // Presence: anyone signed in can read; each user writes only their own.
    match /presence/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId;
    }

  }
}
