rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Tracks: anyone signed in can read; only the creator can write.
    match /tracks/{trackId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == 'animatido@gmail.com';

      // Comments: anyone signed in can read and create;
      // a comment can only be deleted by its own author.
      match /comments/{commentId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth != null
                      && request.auth.uid == resource.data.userId;
      }
    }

    // Users: each user can only read/write their own document.
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Presence: anyone signed in can read; each user writes only their own.
    match /presence/{userId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId;
    }

  }
}
