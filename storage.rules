rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Audio tracks and cover art: anyone signed in can listen/view;
    // only the creator can upload or overwrite files.
    match /{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == 'animatido@gmail.com';
    }

  }
}
